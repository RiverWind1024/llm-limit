{
  "name": "llm-limit",
  "version": "0.1.0",
  "description": "Terminal dashboard for AI coding subscription limits",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "llm",
    "quota",
    "usage",
    "minimax",
    "opencode",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiverWind1024/llm-limit.git"
  },
  "homepage": "https://github.com/RiverWind1024/llm-limit#readme",
  "bugs": {
    "url": "https://github.com/RiverWind1024/llm-limit/issues"
  },
  "bin": {
    "llm-limit": "bin/llm-limit.mjs"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --no-warnings --test test/*.test.mjs",
    "prepare": "npm run build",
    "start": "node --no-warnings dist/cli.js"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
